###################################################################################################
# mod-playerbots configuration
#
# Copy this file to playerbots.conf next to worldserver.conf to change a value: the .dist file
# is read first (defaults), then playerbots.conf over it. ".reload config" reads both again.
###################################################################################################

[worldserver]

#
#    Playerbots.Enable
#        Master switch for the playerbots module (the .playerbots GM commands).
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

Playerbots.Enable = 1

#
#    Playerbots.Summon.Revive
#        A dead bot is revived (full health and mana) when its owner says "summon" in party or
#        raid chat, then comes to him. Bots are never revived on their own; a whispered summon
#        does not revive.
#        Default: 1 - (Only while the owner is out of combat)
#                 0 - (Never: a dead bot stays dead)
#                 2 - (Also while the owner is in combat)

Playerbots.Summon.Revive = 1

#
#    Playerbots.Combat.Log
#        Combat lines in the server log (Server.log, "[mod-playerbots] ...").
#        Default: 1 - (A bot engaging or stopping, and each spell it casts)
#                 0 - (None)
#                 2 - (Also why each rotation step was skipped: not known, condition not met,
#                      cooldown, cast failed with the core's result... logged when the reason changes)

Playerbots.Combat.Log = 1

#
#    Playerbots.Combat.EngageRange
#        Bots fight enemies within this many yards of themselves (an "attack" order has no limit).
#        Default: 30

Playerbots.Combat.EngageRange = 30

#
#    Playerbots.Combat.EngageDelay
#        Milliseconds a bot waits after choosing a new enemy before it attacks, so its owner
#        swings first. Not applied to an "attack" order.
#        Default: 1200

Playerbots.Combat.EngageDelay = 1200

###################################################################################################
# Creating bots (.playerbots create <class> [spec]) and gear (autogear)
###################################################################################################

#
#    Playerbots.Create.AccountPrefix
#        Created bots live on accounts named <prefix>1, <prefix>2... (made when needed). At least
#        3 characters. Bots on these accounts are never anyone's alts.
#        Default: "PLAYERBOT"

Playerbots.Create.AccountPrefix = "PLAYERBOT"

#
#    Playerbots.Create.AccountPassword
#        Password of the bot accounts (nobody needs to log into them).
#        Default: "playerbot"

Playerbots.Create.AccountPassword = "playerbot"

#
#    Playerbots.Create.CharactersPerAccount
#        Bot characters per bot account before the next account is made.
#        Default: 10

Playerbots.Create.CharactersPerAccount = 10

#
#    Playerbots.AutoGear.MinQuality
#    Playerbots.AutoGear.MaxQuality
#        Item qualities a created bot and the "autogear" order may pick:
#        0 poor, 1 common, 2 uncommon, 3 rare, 4 epic, 5 legendary (artifacts and heirlooms never).
#        Default: 0, 4

Playerbots.AutoGear.MinQuality = 0
Playerbots.AutoGear.MaxQuality = 4

#
#    Playerbots.AutoGear.MaxItemLevel
#        Highest item level autogear picks (the bot's level still limits items by their required
#        level). 0 = no limit.
#        Default: 0

Playerbots.AutoGear.MaxItemLevel = 0


#
#    Playerbots.AutoGear.IlvlCap.*
#        Highest item level autogear picks for a bot's level (quest rewards often have no required
#        level, so this is what keeps a low bot out of high gear). Below 60: level + Below60Add; from
#        60: level x the bracket's factor; at 110 only MaxItemLevel applies.
#        Below60Add  (levels 1-59)    Default: 6
#        Factor60    (levels 60-69)   Default: 1.3
#        Factor70    (levels 70-79)   Default: 2.0
#        Factor80    (levels 80-84)   Default: 2.8
#        Factor85    (levels 85-89)   Default: 4.6
#        Factor90    (levels 90-99)   Default: 5.8
#        Factor100   (levels 100-109) Default: 7.0

Playerbots.AutoGear.IlvlCap.Below60Add = 6
Playerbots.AutoGear.IlvlCap.Factor60 = 1.3
Playerbots.AutoGear.IlvlCap.Factor70 = 2.0
Playerbots.AutoGear.IlvlCap.Factor80 = 2.8
Playerbots.AutoGear.IlvlCap.Factor85 = 4.6
Playerbots.AutoGear.IlvlCap.Factor90 = 5.8
Playerbots.AutoGear.IlvlCap.Factor100 = 7.0


#
#    Playerbots.Pool.Accounts
#    Playerbots.Pool.Characters
#    Playerbots.Pool.LoginAtStartup
#        At startup the server makes the missing bot accounts (<AccountPrefix>1..Accounts) and bot
#        characters (Characters in all, classes in turn, factions alternating, starting level), then
#        logs LoginAtStartup of them in; they wait on GM Island. ".playerbots create <class>" first
#        takes a free logged-in bot, then an offline bot character, of that class, of the GM's faction
#        and at most his level, levels and sets it up and brings it into his party; only when there is
#        none is a new character made. 0 turns each part off. The pool is built a few accounts,
#        characters and logins per world update, so the first startup with a large pool keeps
#        working while it fills (watch "Bot pool:" in the log).
#        Default: 100, 600, 50

Playerbots.Pool.Accounts = 100
Playerbots.Pool.Characters = 600
Playerbots.Pool.LoginAtStartup = 50
